# Copy this file to .env in the repo root and add your own key. .env is ignored
# by git, so the key stays on your machine. Never put a real key in this file.
#
# With no key, qanun still works: search and extractive answers need no LLM.

# Preset: groq (the free default), openrouter, gemini or mistral. A preset fills
# in the base URL and model names. Use "compatible" for any other server that
# speaks the OpenAI API, and set QANUN_LLM_BASE_URL and QANUN_LLM_MODEL with it.
QANUN_LLM_PROVIDER=groq
QANUN_LLM_API_KEY=

# Optional overrides of the preset.
# QANUN_LLM_BASE_URL=
# QANUN_LLM_MODEL=
# QANUN_LLM_FAST_MODEL=

# Cross-language search translates each question first, which costs one extra
# request. Set to off to skip it.
# QANUN_TRANSLATE=on

# A reranker runs alongside translation. It downloads a 470 MB model once and adds
# a few seconds per question on a CPU. Set to off to skip it.
# QANUN_RERANKER=mmarco
